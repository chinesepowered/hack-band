# Your Band *user* API key (Band app → Settings → API keys).
# Used to register the agents, play the café owner, and read runs back for the UI.
BAND_API_KEY=

# Optional: point at another Band deployment.
# BAND_REST_URL=https://app.band.ai
# BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket

# Optional: multiply the agents' "thinking" pauses (0 = instant, 1 = natural).
# CAPY_PACE=1
